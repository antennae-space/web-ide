{
  "id": "ai",
  "name": "AI",
  "version": "1.0.0",
  "apiVersion": 1,
  "namespaces": ["assistant", "llm", "agents", "models"],
  "provides": ["assistant", "agents"],
  "contributes": {
    "tools": [
      { "id": "assistant", "label": "Assistant", "icon": "sparkle", "zone": "right", "before": "agents" },
      { "id": "agents", "label": "Agents", "icon": "comment", "zone": "right", "before": "questions" }
    ],
    "commands": [
      { "id": "assistant.doodle", "label": "New doodle", "category": "Tools", "inTerminal": true },
      { "id": "assistant.fullComposer", "label": "Message box in full screen", "category": "Tools" }
    ],
    "mcpTools": ["kanban_conversation", "kanban_reply", "kanban_answer"],
    "settings": {
      "properties": {
        "daily_budget": { "type": "number", "title": "Daily budget (dollars)", "description": "Without a Claude subscription signed in Claude Code, the bars of the Assistant and the Agents tool show what is left of it today: the cost of the agents and the assistant since midnight, at API prices. 0: no budget.", "default": 0 }
      }
    }
  }
}
